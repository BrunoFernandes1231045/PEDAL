SUPABASE_URL=https://<dev-project>.supabase.co
SUPABASE_PUBLIC_URL=https://<dev-project>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key-do-painel-supabase-settings-api>
SUPABASE_SERVICE_KEY=<service-role-key-do-painel-supabase-settings-api>
PORT=3001
NODE_ENV=development

# URL pública usada nas ligações de convite (sem barra final). Tem de constar
# também na lista de Redirect URLs permitidos no painel do Supabase Auth.
PUBLIC_APP_URL=https://<dominio-da-aplicacao>
# Opcional: substitui PUBLIC_APP_URL apenas para convites de coordenadores.
# COORDINATOR_INVITE_REDIRECT_URL=https://<dominio-da-aplicacao>/nova-palavra-passe?tipo=convite-coordenacao

# Exige TOTP/AAL2 em todas as rotas reservadas à coordenação. Desligado por
# omissão em todos os ambientes: só `true` ativa a exigência. Enquanto estiver
# desligado, a password é o único fator a proteger as fichas dos candidatos
# (NIF, CC, morada, assinatura). Os fatores já configurados mantêm-se no
# Supabase e voltam a ser pedidos assim que isto for posto a `true`.
COORDINATOR_MFA_REQUIRED=false

# Cloudflare Turnstile (gratuito). Estas são as chaves oficiais "always pass"
# para desenvolvimento; cria um widget e usa chaves reais em produção. Fora de
# produção o `action` do token não é validado, porque estas chaves devolvem uma
# resposta fixa que não o inclui.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Obrigatório em produção se não for possível derivar de PUBLIC_APP_URL.
TURNSTILE_EXPECTED_HOSTNAMES=<dominio-da-aplicacao>

# Limite atómico por IP e por email, persistido no Supabase pela migration 017.
SIGNUP_PRE_RATE_LIMIT=30
SIGNUP_PRE_RATE_WINDOW_SECONDS=60
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# Liga o envio real do email de "recuperar palavra-passe" (supabase.auth.resetPasswordForEmail).
# Mantém a false em desenvolvimento — o Supabase limita a 2 emails de autenticação/hora.
PASSWORD_RECOVERY_EMAIL_ENABLED=false

# Chave da API Gemini (aistudio.google.com → Get API key). Usada para responder a
# dúvidas do agente quando a correspondência por palavra-chave (FAQ) não chega.
GEMINI_API_KEY=<chave-do-google-ai-studio>
# Interruptor geral — mantém a false até testares o fluxo manualmente.
AI_ENABLED=false

# Emails de aviso de agendamento (novos horários / horário confirmado) enviados
# ao candidato. Separado do SMTP do painel do Supabase — esse só serve para os
# emails de Auth do próprio Supabase, não para emails genéricos da app.
SCHEDULE_EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<o-teu-email>
SMTP_PASS=<app-password-gerada-em-myaccount.google.com/apppasswords>
SMTP_FROM_EMAIL=<o-teu-email>
SMTP_FROM_NAME=PEDAL

# Verificação diária (09:00) a candidatos parados há 21 dias em onboarding,
# formalização ou à espera de agendar a prática — envia "continuas interessado?"
# uma vez por fase. Usa o mesmo SMTP acima. Mantém a false salvo quando
# quiseres mesmo testar contra dados reais — não há separação dev/prod na BD.
STAGE_REMINDER_EMAILS_ENABLED=false
